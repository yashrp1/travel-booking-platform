# Application Environment
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password123@localhost:5432/wanderstay?schema=public"

# Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET="wanderstay_production_jwt_secret_key_8921"
JWT_EXPIRATION="7d"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Google Maps API
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Communication Gateways
SMS_GATEWAY_API_KEY="your_sms_gateway_key"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your_sendgrid_password"
SMTP_FROM_EMAIL="support@wanderstay.com"
